---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getPublishedBlogPosts, getAllBlogTags } from '../../utils/content';

const allPosts = await getPublishedBlogPosts();
const allTags = await getAllBlogTags();
const categories = ['全部', ...Array.from(new Set(allPosts.map(p => p.data.category)))];
---

<BaseLayout
  title="技术博客 - Alex.dev"
  description="沉淀技术探索、全栈架构经验、AI 智能体开发与数字生活思考。"
>
  <div class="space-y-10">
    <!-- Header -->
    <header class="space-y-3">
      <div class="text-xs font-mono text-cyber-purple tracking-widest uppercase">// DIGITAL WRITINGS</div>
      <h1 class="text-3xl sm:text-4xl font-heading font-bold text-white tracking-tight">
        技术博客 (Blog)
      </h1>
      <p class="text-base text-cyber-muted max-w-2xl">
        记录技术洞察、架构演进与实践随笔。支持按标签与分类快速检索。
      </p>
    </header>

    <!-- Search & Filter Controls -->
    <div class="space-y-4 pt-2">
      <!-- Search Input -->
      <div class="relative max-w-md">
        <input
          id="search-input"
          type="text"
          placeholder="搜索文章标题、简介或关键词..."
          class="w-full px-4 py-2.5 pl-10 rounded-lg text-sm bg-cyber-surface2 border border-cyber-border text-white placeholder-cyber-muted focus:outline-none focus:border-cyber-cyan transition-colors"
        />
        <svg class="w-4 h-4 text-cyber-muted absolute left-3.5 top-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <!-- Categories & Tags Bar -->
      <div class="flex flex-wrap items-center gap-2 border-b border-cyber-border/80 pb-4">
        <span class="text-xs font-mono text-cyber-muted mr-1">分类:</span>
        {categories.map((cat, idx) => (
          <button
            type="button"
            class={`category-filter px-3 py-1 rounded text-xs font-mono transition-all ${
              idx === 0
                ? 'bg-cyber-cyan/20 border border-cyber-cyan text-cyber-cyan font-medium'
                : 'bg-cyber-surface2 text-cyber-muted hover:text-white border border-cyber-border'
            }`}
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Popular Tags -->
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-mono text-cyber-muted mr-1">热门标签:</span>
        {allTags.map(({ tag, count }) => (
          <a
            href={`/blog/tag/${tag}`}
            class="px-2.5 py-0.5 rounded text-xs font-mono bg-cyber-surface/60 border border-cyber-border text-slate-400 hover:text-cyber-cyan hover:border-cyber-cyan/40 transition-colors"
          >
            #{tag} <span class="text-[10px] text-cyber-muted/80">({count})</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Posts Stream -->
    <div id="posts-container" class="grid grid-cols-1 gap-5">
      {allPosts.map((post) => (
        <div
          class="post-wrapper"
          data-title={post.data.title.toLowerCase()}
          data-description={post.data.description.toLowerCase()}
          data-category={post.data.category}
          data-tags={post.data.tags.join(',').toLowerCase()}
        >
          <BlogCard post={post} />
        </div>
      ))}
    </div>

    <!-- Empty Search State -->
    <div id="no-results" class="hidden text-center py-16 space-y-3">
      <div class="text-3xl">🔍</div>
      <p class="text-sm font-mono text-cyber-muted">未找到匹配的文章，请尝试更换关键词。</p>
    </div>
  </div>
</BaseLayout>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const categoryButtons = document.querySelectorAll('.category-filter');
  const postWrappers = document.querySelectorAll('.post-wrapper');
  const noResults = document.getElementById('no-results');

  let activeCategory = '全部';
  let searchTerm = '';

  function filterPosts() {
    let visibleCount = 0;

    postWrappers.forEach((item) => {
      const el = item as HTMLElement;
      const title = el.getAttribute('data-title') || '';
      const desc = el.getAttribute('data-description') || '';
      const tags = el.getAttribute('data-tags') || '';
      const category = el.getAttribute('data-category') || '';

      const matchesSearch = !searchTerm || 
        title.includes(searchTerm) || 
        desc.includes(searchTerm) || 
        tags.includes(searchTerm);

      const matchesCategory = activeCategory === '全部' || category === activeCategory;

      if (matchesSearch && matchesCategory) {
        el.style.display = 'block';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });

    if (noResults) {
      if (visibleCount === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchTerm = (e.target as HTMLInputElement).value.trim().toLowerCase();
      filterPosts();
    });
  }

  categoryButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      categoryButtons.forEach((b) => {
        b.classList.remove('bg-cyber-cyan/20', 'border-cyber-cyan', 'text-cyber-cyan', 'font-medium');
        b.classList.add('bg-cyber-surface2', 'text-cyber-muted', 'border-cyber-border');
      });
      btn.classList.add('bg-cyber-cyan/20', 'border-cyber-cyan', 'text-cyber-cyan', 'font-medium');
      btn.classList.remove('bg-cyber-surface2', 'text-cyber-muted', 'border-cyber-border');

      activeCategory = btn.getAttribute('data-category') || '全部';
      filterPosts();
    });
  });
</script>
