---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroTerminal from '../components/HeroTerminal.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import GlowCard from '../components/GlowCard.astro';
import { getFeaturedProjects, getPublishedBlogPosts } from '../utils/content';

const featuredProjects = await getFeaturedProjects();
const allPosts = await getPublishedBlogPosts();
const latestPosts = allPosts.slice(0, 3);

const skillCategories = [
  {
    title: 'AI 智能体与大模型',
    icon: '🤖',
    skills: ['LangGraph / Multi-Agent', '7角色数字员工编排', 'RAG & 向量检索', '国产与开源大模型调度', 'SSE 实时流式响应'],
  },
  {
    title: '全栈架构与开发',
    icon: '⚡',
    skills: ['Astro 5', 'React / Next.js', 'FastAPI & Python', 'TypeScript', 'Tailwind CSS', 'ComWeChatRobot 微信集成'],
  },
  {
    title: '边缘计算与云原生',
    icon: '☁️',
    skills: ['Cloudflare Pages / Workers', 'Cloudflare Email 体系', 'Docker 容器化', 'PostgreSQL / ChromaDB', 'HMAC 审计链'],
  },
  {
    title: '工程化与开源贡献',
    icon: '🛠️',
    skills: ['GitHub Actions CI/CD', 'Git 版本控制', '自动化测试与 QA 循环', 'RESTful / WebSocket API', '性能极限优化'],
  },
];
---

<BaseLayout
  title="谢怀安 (Huaian.dev) - 暗色科技风个人网站 | AI 智能体与全栈架构"
  description="谢怀安的个人主页与技术空间，专注于多智能体协作（Multi-Agent Team）、微信 AI 助手、AI 浏览器与现代化 Web 应用。"
>
  <!-- Hero Section -->
  <section class="pt-6 sm:pt-12 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <!-- Left Info Column -->
      <div class="lg:col-span-7 space-y-6">
        <!-- Status Indicator -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-cyber-green/10 border border-cyber-green/30 text-cyber-green">
          <span class="w-2 h-2 rounded-full bg-cyber-green animate-pulse"></span>
          <span>AVAILABLE FOR NEW PROJECTS · XIEHUAIAN.DE5.NET</span>
        </div>

        <!-- Big Headline -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-heading font-bold text-white tracking-tight leading-[1.15]">
          构建下一代数字员工与<br />
          <span class="text-gradient-cyber">AI 智能体协作生态</span>
        </h1>

        <!-- Bio Description -->
        <p class="text-base sm:text-lg text-cyber-muted max-w-xl leading-relaxed">
          你好，我是 <span class="text-white font-medium">谢怀安 (Xie Huaian)</span>。专注于多智能体编排（Multi-Agent Team）、AI 智能助手与全栈工程落地，探索大语言模型与自动化工作流的深度融合。
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="/portfolio"
            class="px-5 py-2.5 rounded-lg text-sm font-mono font-semibold bg-cyber-cyan text-cyber-bg hover:bg-cyber-neonCyan transition-all shadow-[0_0_20px_rgba(0,240,255,0.4)] flex items-center gap-2"
          >
            <span>🚀 探索作品集</span>
            <span>&rarr;</span>
          </a>
          <a
            href="https://github.com/xiehuaian77-sketch"
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-lg text-sm font-mono font-medium text-slate-200 bg-cyber-surface2 border border-cyber-border hover:border-cyber-cyan hover:text-cyber-cyan transition-all flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            <span>GitHub @xiehuaian77-sketch</span>
          </a>
          <a
            href="/blog"
            class="px-4 py-2.5 rounded-lg text-sm font-mono text-cyber-muted hover:text-white transition-colors"
          >
            阅读博客 &gt;
          </a>
        </div>
      </div>

      <!-- Right Terminal Column -->
      <div class="lg:col-span-5">
        <HeroTerminal />
      </div>
    </div>
  </section>

  <!-- Featured Projects Section -->
  <section class="py-16 border-t border-cyber-border/60">
    <div class="flex items-center justify-between mb-10">
      <div>
        <div class="text-xs font-mono text-cyber-cyan tracking-widest uppercase">// PORTFOLIO HIGHLIGHTS</div>
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-white mt-1">亮点精选作品</h2>
      </div>
      <a
        href="/portfolio"
        class="text-xs sm:text-sm font-mono text-cyber-cyan hover:underline inline-flex items-center gap-1 group"
      >
        <span>查看全部作品</span>
        <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredProjects.slice(0, 3).map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <!-- Latest Writings Section -->
  <section class="py-16 border-t border-cyber-border/60">
    <div class="flex items-center justify-between mb-10">
      <div>
        <div class="text-xs font-mono text-cyber-purple tracking-widest uppercase">// LATEST WRITINGS</div>
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-white mt-1">最新技术博文</h2>
      </div>
      <a
        href="/blog"
        class="text-xs sm:text-sm font-mono text-cyber-purple hover:underline inline-flex items-center gap-1 group"
      >
        <span>浏览全部文章</span>
        <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 gap-5">
      {latestPosts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>
  </section>

  <!-- Skills Matrix Section -->
  <section class="py-16 border-t border-cyber-border/60">
    <div class="mb-10 text-center sm:text-left">
      <div class="text-xs font-mono text-cyber-green tracking-widest uppercase">// SKILLS &amp; CAPABILITIES</div>
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-white mt-1">核心技术栈与专业能力</h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {skillCategories.map((cat) => (
        <GlowCard class="p-5 flex flex-col justify-between">
          <div>
            <div class="text-2xl mb-3">{cat.icon}</div>
            <h3 class="font-heading font-bold text-base text-white">{cat.title}</h3>
            <ul class="mt-4 space-y-2 text-xs font-mono text-cyber-muted">
              {cat.skills.map((skill) => (
                <li class="flex items-center gap-2">
                  <span class="text-cyber-cyan">▸</span>
                  <span>{skill}</span>
                </li>
              ))}
            </ul>
          </div>
        </GlowCard>
      ))}
    </div>
  </section>

  <!-- Get In Touch CTA Banner -->
  <section class="py-12 mt-6">
    <div class="relative rounded-2xl overflow-hidden p-8 sm:p-12 bg-gradient-to-r from-cyber-surface to-cyber-surface2 border border-cyber-cyan/30 shadow-[0_0_50px_-15px_rgba(0,240,255,0.2)]">
      <div class="absolute -right-16 -bottom-16 w-64 h-64 bg-cyber-cyan/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 max-w-2xl space-y-4">
        <div class="text-xs font-mono text-cyber-cyan uppercase tracking-widest">// READY TO CONNECT</div>
        <h2 class="text-2xl sm:text-4xl font-heading font-bold text-white leading-tight">
          准备好开启 AI 智能体合作，<br />或探讨技术方案了吗？
        </h2>
        <p class="text-sm sm:text-base text-cyber-muted leading-relaxed">
          欢迎交流 AI 智能体落地、SaaS 系统架构与定制化开发。
        </p>
        <div class="pt-4 flex flex-wrap items-center gap-4">
          <a
            href="/contact"
            class="px-6 py-3 rounded-lg text-xs font-mono font-semibold bg-cyber-cyan text-cyber-bg hover:bg-cyber-neonCyan transition-all shadow-[0_0_20px_rgba(0,240,255,0.4)]"
          >
            ✉️ 立即取得联系
          </a>
          <a
            href="/about"
            class="px-6 py-3 rounded-lg text-xs font-mono text-slate-300 bg-cyber-surface border border-cyber-border hover:border-cyber-cyan hover:text-white transition-colors"
          >
            查看关于我 &gt;
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
