---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlowCard from '../components/GlowCard.astro';

const timeline = [
  {
    period: '2024 - 至今',
    role: 'AI 智能体架构师 & 独立开发者',
    company: '开源探索 / 独立创业',
    description: '主导研发 7 角色 AI 数字员工协同编排引擎 (multi-agent-team)、AI 智能体工作流 SaaS 平台与智能微信机器人体系。',
    tags: ['LangGraph', 'Multi-Agent', 'FastAPI', 'Astro', 'ChromaDB', 'SSE'],
  },
  {
    period: '2022 - 2024',
    role: '全栈开发工程师',
    company: 'AI 与企业服务技术研发',
    description: '负责企业级自动化工作流系统的全栈实现、高性能微服务架构与大模型接口协议的无缝集成。',
    tags: ['Python', 'TypeScript', 'Docker', 'PostgreSQL', 'Cloudflare'],
  },
  {
    period: '2020 - 2022',
    role: '软件工程师',
    company: '互联网科技创新',
    description: '攻关高可用后端架构、实时数据流处理与自动化测试质量保障体系。',
    tags: ['Node.js', 'React', 'Linux', 'Git CI/CD'],
  },
];

const productivityGear = [
  { category: '开发主力环境', item: 'Windows / Linux + VS Code / Cursor' },
  { category: 'AI 智能体核心栈', item: 'LangGraph + FastAPI + ChromaDB' },
  { category: '前端框架', item: 'Astro 5 + React + Tailwind CSS' },
  { category: '云端与边缘', item: 'Cloudflare Pages / Workers + Docker' },
  { category: '主选字体', item: 'JetBrains Mono / Space Grotesk' },
  { category: '代码托管与 CI', item: 'GitHub @xiehuaian77-sketch' },
];
---

<BaseLayout
  title="关于我 - 谢怀安 (Huaian.dev)"
  description="谢怀安 (Xie Huaian) 的个人简介、技术成长经历与工作流配置。"
>
  <div class="max-w-4xl mx-auto space-y-16">
    <!-- Header / Bio Intro -->
    <section class="space-y-8">
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-8">
        <!-- Avatar -->
        <div class="relative group shrink-0">
          <div class="w-32 h-32 rounded-2xl overflow-hidden border-2 border-cyber-cyan/50 p-1 bg-cyber-surface shadow-[0_0_30px_rgba(0,240,255,0.2)]">
            <img
              src="/images/avatar.svg"
              alt="谢怀安 Avatar"
              class="w-full h-full object-cover rounded-xl"
            />
          </div>
          <div class="absolute -bottom-2 -right-2 px-2 py-0.5 rounded text-[10px] font-mono bg-cyber-green/20 border border-cyber-green text-cyber-green">
            ONLINE
          </div>
        </div>

        <!-- Info Details -->
        <div class="space-y-3 text-center sm:text-left">
          <div class="text-xs font-mono text-cyber-cyan tracking-widest uppercase">// ABOUT ME</div>
          <h1 class="text-3xl sm:text-4xl font-heading font-bold text-white tracking-tight">
            你好，我是 <span class="text-gradient-cyber">谢怀安 (Xie Huaian)</span>
          </h1>
          <p class="text-sm font-mono text-cyber-muted">
            AI Agent 架构师 / 全栈工程师 / 开源创造者 · xiehuaian.de5.net
          </p>
          <p class="text-base text-slate-300 leading-relaxed max-w-2xl pt-2">
            热衷于探索自主智能体（Autonomous Agents）与数字员工（Digital Workforce）协同范式。长期致力于将前沿大模型能力转化为高可靠、工业级的自动化软件与交互产品。
          </p>
          <div class="pt-2 flex flex-wrap items-center justify-center sm:justify-start gap-3 text-xs font-mono">
            <a
              href="https://github.com/xiehuaian77-sketch"
              target="_blank"
              rel="noopener noreferrer"
              class="text-cyber-cyan hover:underline inline-flex items-center gap-1"
            >
              <span>GitHub: @xiehuaian77-sketch</span>
              <span>&rarr;</span>
            </a>
            <span class="text-cyber-muted">•</span>
            <span class="text-slate-400">Email: xiehuaian77@gmail.com</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Career Experience Timeline -->
    <section class="space-y-8">
      <div>
        <div class="text-xs font-mono text-cyber-purple tracking-widest uppercase">// CAREER &amp; MILESTONES</div>
        <h2 class="text-2xl font-heading font-bold text-white mt-1">经历与代表作</h2>
      </div>

      <div class="relative border-l-2 border-cyber-border/80 pl-6 sm:pl-8 space-y-10 ml-2">
        {timeline.map((item) => (
          <div class="relative group">
            <!-- Timeline Node Point -->
            <div class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-4 h-4 rounded-full bg-cyber-bg border-2 border-cyber-cyan group-hover:bg-cyber-cyan transition-colors shadow-[0_0_10px_rgba(0,240,255,0.5)]"></div>
            
            <div class="space-y-2">
              <div class="flex flex-wrap items-center gap-3">
                <span class="px-2.5 py-0.5 rounded text-xs font-mono bg-cyber-cyan/10 border border-cyber-cyan/30 text-cyber-cyan">
                  {item.period}
                </span>
                <span class="text-xs font-mono text-cyber-muted">{item.company}</span>
              </div>
              <h3 class="text-lg font-heading font-bold text-white">
                {item.role}
              </h3>
              <p class="text-sm text-cyber-muted leading-relaxed">
                {item.description}
              </p>
              <div class="flex flex-wrap gap-1.5 pt-2">
                {item.tags.map((tag) => (
                  <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-cyber-surface2 border border-cyber-border text-slate-400">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Productivity Gear & Setup -->
    <section class="space-y-6">
      <div>
        <div class="text-xs font-mono text-cyber-green tracking-widest uppercase">// WORKSPACE &amp; TECH STACK</div>
        <h2 class="text-2xl font-heading font-bold text-white mt-1">技术栈与生产力配置</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {productivityGear.map((gear) => (
          <GlowCard class="p-4 flex flex-col justify-between">
            <div class="text-xs font-mono text-cyber-muted">// {gear.category}</div>
            <div class="text-sm font-heading font-bold text-white mt-2">{gear.item}</div>
          </GlowCard>
        ))}
      </div>
    </section>

    <!-- Contact Jump Box -->
    <section class="p-8 rounded-xl cyber-glass border border-cyber-border flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="text-lg font-heading font-bold text-white">想与我探讨 AI 智能体或展开合作？</h3>
        <p class="text-xs sm:text-sm text-cyber-muted mt-1">
          随时欢迎通过邮件或 GitHub 交流，期待与您连接。
        </p>
      </div>
      <a
        href="/contact"
        class="px-5 py-2.5 rounded-lg text-xs font-mono font-semibold bg-cyber-cyan text-cyber-bg hover:bg-cyber-neonCyan transition-all shadow-[0_0_15px_rgba(0,240,255,0.3)] shrink-0"
      >
        前往联系页面 &rarr;
      </a>
    </section>
  </div>
</BaseLayout>
