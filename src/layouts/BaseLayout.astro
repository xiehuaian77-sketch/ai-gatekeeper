---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoMeta from '../components/SeoMeta.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  pubDate?: Date;
}

const { title, description, image, article, pubDate } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="dark scroll-smooth">
  <head>
    <SeoMeta
      title={title}
      description={description}
      image={image}
      article={article}
      pubDate={pubDate}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-cyber-bg text-cyber-text antialiased selection:bg-cyber-cyan/20 selection:text-cyber-cyan">
    <!-- Ambient Background Lights & Grid -->
    <div class="fixed inset-0 bg-cyber-grid pointer-events-none z-0 opacity-40"></div>
    <div class="fixed top-0 left-1/4 w-96 h-96 bg-cyber-cyan/5 rounded-full blur-3xl pointer-events-none z-0"></div>
    <div class="fixed top-1/3 right-1/4 w-96 h-96 bg-cyber-purple/5 rounded-full blur-3xl pointer-events-none z-0"></div>

    <!-- Site Header -->
    <Header />

    <!-- Main Content Container -->
    <main class="relative z-10 flex-1 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-8 sm:py-12">
      <slot />
    </main>

    <!-- Site Footer -->
    <Footer class="relative z-10" />
  </body>
</html>
