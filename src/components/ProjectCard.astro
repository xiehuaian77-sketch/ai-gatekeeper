---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  project: CollectionEntry<'portfolio'>;
  featured?: boolean;
}

const { project } = Astro.props;
const { data, slug } = project;
---

<div class="group relative rounded-xl bg-cyber-surface/90 border border-cyber-border hover:border-cyber-cyan/50 transition-all duration-300 hover:shadow-[0_0_25px_-5px_rgba(0,240,255,0.2)] flex flex-col overflow-hidden">
  <!-- Card Image Header -->
  <a href={`/portfolio/${slug}`} class="relative block aspect-[16/9] overflow-hidden bg-cyber-surface2 border-b border-cyber-border">
    <img
      src={data.heroImage || '/images/portfolio-placeholder.svg'}
      alt={data.title}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-cyber-surface via-transparent to-transparent opacity-60"></div>
    
    <!-- Category Badge -->
    <div class="absolute top-3 left-3">
      <span class="px-2.5 py-1 rounded-md text-[11px] font-mono font-medium tracking-wide bg-cyber-bg/90 border border-cyber-cyan/40 text-cyber-cyan backdrop-blur-md">
        {data.category}
      </span>
    </div>

    {data.featured && (
      <div class="absolute top-3 right-3">
        <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-cyber-purple/20 border border-cyber-purple/50 text-cyber-neonPurple backdrop-blur-md">
          ★ FEATURED
        </span>
      </div>
    )}
  </a>

  <!-- Card Body -->
  <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
    <div>
      <h3 class="text-lg font-heading font-bold text-white group-hover:text-cyber-cyan transition-colors">
        <a href={`/portfolio/${slug}`}>
          {data.title}
        </a>
      </h3>
      <p class="mt-2 text-sm text-cyber-muted line-clamp-2 leading-relaxed">
        {data.description}
      </p>
    </div>

    <!-- Tags & Links Footer -->
    <div class="pt-3 border-t border-cyber-border/60 space-y-3">
      <!-- Tags -->
      <div class="flex flex-wrap gap-1.5">
        {data.tags.map((tag) => (
          <span class="px-2 py-0.5 rounded text-[11px] font-mono text-slate-400 bg-cyber-surface2 border border-cyber-border/80">
            #{tag}
          </span>
        ))}
      </div>

      <!-- Action Links -->
      <div class="flex items-center justify-between pt-1">
        <a
          href={`/portfolio/${slug}`}
          class="text-xs font-mono text-cyber-cyan hover:underline inline-flex items-center gap-1 group/btn"
        >
          <span>查看详情</span>
          <span class="group-hover/btn:translate-x-1 transition-transform">&rarr;</span>
        </a>

        <div class="flex items-center gap-2">
          {data.githubUrl && (
            <a
              href={data.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="p-1.5 rounded text-cyber-muted hover:text-white hover:bg-cyber-surface2 transition-colors"
              title="查看源码"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
            </a>
          )}
          {data.liveUrl && (
            <a
              href={data.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="p-1.5 rounded text-cyber-cyan hover:bg-cyber-cyan/10 transition-colors"
              title="在线体验 Demo"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</div>
