---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { name: '首页', href: '/' },
  { name: '作品集', href: '/portfolio' },
  { name: '博客', href: '/blog' },
  { name: '关于我', href: '/about' },
  { name: '联系', href: '/contact' },
];

const isActive = (href: string) => {
  if (href === '/') {
    return currentPath === '/' || currentPath === '';
  }
  return currentPath.startsWith(href);
};
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-cyber-bg/85 border-b border-cyber-border/80 transition-all duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group text-decoration-none">
      <div class="w-8 h-8 rounded-lg bg-cyber-surface2 border border-cyber-border group-hover:border-cyber-cyan flex items-center justify-center text-cyber-cyan transition-colors">
        <span class="font-mono text-sm font-bold">&gt;_</span>
      </div>
      <span class="font-heading font-bold text-lg text-white tracking-wide group-hover:text-cyber-cyan transition-colors">
        Huaian<span class="text-cyber-cyan">.dev</span>
      </span>
      <span class="inline-block w-2 h-4 bg-cyber-cyan animate-blink"></span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-1">
      {navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`relative px-3.5 py-1.5 rounded-lg text-sm font-medium transition-all duration-200 ${
              active
                ? 'text-cyber-cyan bg-cyber-cyan/10 border border-cyber-cyan/30 shadow-[0_0_12px_rgba(0,240,255,0.15)]'
                : 'text-cyber-muted hover:text-white hover:bg-cyber-surface2/60 border border-transparent'
            }`}
          >
            {item.name}
          </a>
        );
      })}
    </nav>

    <!-- Right Actions -->
    <div class="hidden md:flex items-center gap-3">
      <a
        href="https://github.com/xiehuaian77-sketch"
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 rounded-lg text-cyber-muted hover:text-white hover:bg-cyber-surface2 border border-transparent hover:border-cyber-border transition-colors"
        title="GitHub @xiehuaian77-sketch"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>
      <a
        href="/rss.xml"
        class="p-2 rounded-lg text-cyber-muted hover:text-cyber-cyan hover:bg-cyber-surface2 border border-transparent hover:border-cyber-border transition-colors"
        title="RSS 订阅"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z" />
        </svg>
      </a>
      <a
        href="/contact"
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-mono font-medium text-cyber-bg bg-cyber-cyan hover:bg-cyber-neonCyan transition-all shadow-[0_0_15px_rgba(0,240,255,0.4)]"
      >
        <span>GET IN TOUCH</span>
      </a>
    </div>

    <!-- Mobile Hamburger Button -->
    <div class="flex items-center md:hidden">
      <button
        id="mobile-menu-btn"
        type="button"
        class="p-2 rounded-lg text-cyber-muted hover:text-white hover:bg-cyber-surface2 focus:outline-none"
        aria-label="打开导航菜单"
      >
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-cyber-border bg-cyber-surface/95 backdrop-blur-2xl px-4 pt-2 pb-6 space-y-2">
    {navItems.map((item) => {
      const active = isActive(item.href);
      return (
        <a
          href={item.href}
          class={`block px-4 py-2.5 rounded-lg text-base font-medium transition-colors ${
            active
              ? 'text-cyber-cyan bg-cyber-cyan/10 border border-cyber-cyan/30'
              : 'text-cyber-muted hover:text-white hover:bg-cyber-surface2'
          }`}
        >
          {item.name}
        </a>
      );
    })}
    <div class="pt-4 border-t border-cyber-border flex items-center justify-between px-2">
      <a href="https://github.com/xiehuaian77-sketch" target="_blank" rel="noopener noreferrer" class="text-sm font-mono text-cyber-cyan hover:underline flex items-center gap-1.5">
        GitHub @xiehuaian77-sketch
      </a>
      <a href="/contact" class="text-sm font-mono text-cyber-purple hover:underline">
        联系方式 &rarr;
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');

  if (menuBtn && menu && openIcon && closeIcon) {
    menuBtn.addEventListener('click', () => {
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        openIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      } else {
        menu.classList.add('hidden');
        openIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      }
    });
  }
</script>
