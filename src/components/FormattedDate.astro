---
import { formatDate } from '../utils/date';

interface Props {
  date: Date | string;
  class?: string;
}

const { date, class: className = '' } = Astro.props;
const formatted = formatDate(date);
---

<time datetime={typeof date === 'string' ? date : date.toISOString()} class={`inline-flex items-center gap-1.5 text-xs text-cyber-muted font-mono ${className}`}>
  <svg class="w-3.5 h-3.5 text-cyber-cyan/80" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
  </svg>
  <span>{formatted}</span>
</time>
