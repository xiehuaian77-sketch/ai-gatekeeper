# ============================================================
# AI Gatekeeper — Testnet Environment Configuration Template
# NOTE: NEVER commit your real .env or private keys to git!
# ============================================================

# Network Selection: 'hardhat' or 'sepolia'
NETWORK=sepolia
CHAIN_ID=11155111

# Public RPC Endpoint (Infura, Alchemy, or public Sepolia node)
SEPOLIA_RPC_URL=

# Deployed Vault Contract Address on Sepolia (filled after deploy)
CONTRACT_ADDRESS=

# Gatekeeper Signer Private Key (Testnet Only! Never use mainnet funds or keys)
GATEKEEPER_PRIVATE_KEY=

# Google Gemini API Key (Optional: fallback simulator used if empty)
GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash

# Policy Guard & Vault Caps (ETH)
MAX_CLAIM_AMOUNT_ETH=0.05
DEMO_MAX_TOTAL_PAYOUT_ETH=0.5
INITIAL_VAULT_FUNDING=0.01

# Backend Server
PORT=3000
HOST=0.0.0.0
